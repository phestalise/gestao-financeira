# Firebase Admin (console.firebase.google.com > Configurações do projeto > Contas de serviço > Gerar nova chave privada)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Gemini (aistudio.google.com/apikey)
GEMINI_API_KEY=

# Assina os cookies de sessão (invente um texto longo e aleatório; trocar desloga todo mundo)
APP_SECRET=

# Seu e-mail: ao se cadastrar com ele, você herda os dados de antes do cadastro (users/default-user)
OWNER_EMAIL=
