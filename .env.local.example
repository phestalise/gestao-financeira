# Firebase Admin (console.firebase.google.com > Configurações do projeto > Contas de serviço > Gerar nova chave privada)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Gemini (aistudio.google.com/apikey)
GEMINI_API_KEY=

# Acesso ao app (invente uma senha e um segredo aleatório, só você precisa saber)
APP_PASSCODE=
APP_SECRET=
