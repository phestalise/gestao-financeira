rules_version = '2';

// O app nunca acessa o Firestore pelo navegador — só pelo servidor (Firebase Admin SDK,
// que ignora estas regras). Por isso o acesso direto do cliente fica totalmente bloqueado
// aqui como camada extra de segurança, caso alguém tente ler/escrever direto pela Web API.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
